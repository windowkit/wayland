{
  "name": "@windowkit/wayland",
  "version": "3.1.1",
  "description": "Pure JavaScript Wayland client: the wire protocol, proxies generated from protocol XML, and file descriptor passing. A fork of wayland-client.",
  "keywords": [
    "wayland",
    "wayland-client",
    "wayland-protocol",
    "xdg-shell",
    "compositor"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "imports": {
    "#dist/*": "./dist/*"
  },
  "scripts": {
    "start": "node index.js",
    "test": "mocha",
    "prepack": "npm run build && node convert.js --types protocol",
    "build": "tsc -b ."
  },
  "bin": {
    "convert-xml": "convert.js"
  },
  "author": "Sebastien DUMETZ <s.dumetz@holusion.com>",
  "contributors": [
    "Andrey Sidorov <andrey.sidorov@gmail.com>"
  ],
  "homepage": "https://github.com/windowkit/wayland#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windowkit/wayland.git"
  },
  "bugs": {
    "url": "https://github.com/windowkit/wayland/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "mocha": {
    "recursive": true,
    "spec": [
      "dist/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "convert.js",
    "protocol/*.json",
    "protocol/*.d.ts",
    "NOTICE"
  ],
  "optionalDependencies": {
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@types/chai": "^4.3.13",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.19.15",
    "chai": "^4.3.10",
    "mocha": "^12.0.1",
    "typescript": "^5.9.3",
    "xml-js": "^1.6.11"
  }
}
